--- a/apps/playlist_catalog.c	2026-11-03 20:52:46
+++ b/apps/playlist_catalog.c	2026-11-03 20:53:33
@@ -145,6 +145,33 @@
     }
 }
 
+/* Where the catalog browser opens: the most recent playlist's path relative
+ * to the catalog dir root ("Folder/List.m3u8"), or "" if it isn't in there.
+ * With top_only, just its first part, so the browser opens at the top level
+ * with the folder that holds it selected. */
+static void catalog_reopen_path(char *buf, size_t bufsz, const char *root,
+                                bool top_only)
+{
+    const char *p = most_recent_playlist;
+    size_t len = strlen(root);
+
+    buf[0] = '\0';
+    while (len > 0 && root[len - 1] == PATH_SEPCH)
+        len--;
+    if (len == 0 || strncmp(p, root, len) || p[len] != PATH_SEPCH)
+        return;
+    p += len;
+    while (*p == PATH_SEPCH)
+        p++;
+    strmemccpy(buf, p, bufsz);
+    if (top_only)
+    {
+        char *sep = strchr(buf, PATH_SEPCH);
+        if (sep)
+            *sep = '\0';
+    }
+}
+
