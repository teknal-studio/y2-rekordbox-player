diff --color -ru a/apps/tree.c b/apps/tree.c
--- a/apps/tree.c	2026-11-03 20:08:34
+++ b/apps/tree.c	2026-11-03 20:53:01
@@ -1137,9 +1137,41 @@
 
             if (browse->selected)
             {
-                set_current_file_ex(browse->root, browse->selected);
-                /* set_current_file changes dirlevel, change it back */
-                tc.dirlevel = 0;
+                /* selected is relative to root and may be in a subfolder
+                   ("Folder/List.m3u8"): open that subfolder with the file
+                   selected, and count dirlevel from root so Back goes up one
+                   folder at a time and stops at root. If the subfolder is
+                   gone, open root as before. */
+                const char *sel = browse->selected;
+                const char *leaf;
+                char path[MAX_PATH];
+                int levels = 0;
+                size_t rootlen = strlen(browse->root);
+
+                while (rootlen > 0 && browse->root[rootlen - 1] == PATH_SEPCH)
+                    rootlen--;
+                while (*sel == PATH_SEPCH)
+                    sel++;
+                leaf = strrchr(sel, PATH_SEPCH);
+
+                if (leaf && leaf[1] != '\0' &&
+                    snprintf(path, sizeof(path), "%.*s/%.*s", (int)rootlen,
+                             browse->root, (int)(leaf - sel), sel)
+                        < (int)sizeof(path) &&
+                    dir_exists(path))
+                {
+                    for (const char *p = sel; p <= leaf; p++)
+                    {
+                        if (*p == PATH_SEPCH)
+                            levels++;
+                    }
+                    strlcat(path, leaf, sizeof(path));
+                    set_current_file_ex(path, NULL);
+                }
+                else
+                    set_current_file_ex(browse->root, sel);
+                /* set_current_file changes dirlevel, set it relative to root */
+                tc.dirlevel = levels;
             }
 
             ret_val = dirbrowse();
